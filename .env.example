# Copy to .env and replace every secret before running outside this machine.
# Never commit the real .env file.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=cat_puzzle
MYSQL_USER=catpuzzle
MYSQL_PASSWORD=change-me-db

# Local backend (host MySQL published by Docker Compose).
# For Aiven, use the service host, port, user, and database, and set MYSQL_SSL_CA
# to the project CA certificate downloaded from the service page.
DATABASE_URL=mysql+pymysql://catpuzzle:change-me-db@127.0.0.1:3306/cat_puzzle
MYSQL_SSL_CA=

# Generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_MINUTES=43200
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=access_token

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_DIR=storage
MAX_UPLOAD_BYTES=8388608

SOLVER_SOLUTION_LIMIT=20
SOLVER_TIMEOUT_SECONDS=10

# Local development can leave verification optional.
# Set true when SMTP is configured.
REQUIRE_EMAIL_VERIFICATION=false

# Must be false in any shared or production environment.
# When true, forgot-password and signup responses include tokens so local tests work without SMTP.
DEBUG_RETURN_TOKENS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@catpuzzle.local
SMTP_TLS=true

APP_PUBLIC_URL=http://localhost:5173
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# Optional S3 storage for AWS. Leave blank to store uploads on local disk.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
